# -------------------------------------------------------
# CARA PAKAI:
# 1. Copy file ini: cp .env.example .env
# 2. Isi nilai di bawah dengan credentials asli
# 3. JANGAN commit .env ke GitHub
# -------------------------------------------------------

# -------------------------------------------------------
# Supabase / PostgreSQL
# Ambil dari: supabase.com → project → Settings → Database
# -------------------------------------------------------
SUPABASE_HOST=your-project-id.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_database_password_here

# -------------------------------------------------------
# Groq API
# Ambil dari: console.groq.com → API Keys
# -------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here